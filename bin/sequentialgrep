#!/bin/bash

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, they can
    # skim the long one.
    printf 'Usage: %q %s\n' "$(basename "$1")" '[--extended-regexp] -e PATTERNS|-E PATTERNS [-e ...] [-l|--files-with-matches] [--per-file] [-u|--unbuffered] [--] [FILE ...] [-?|-h|--help]'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Print lines that match patterns one after another, in order.
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --extended-regexp	Interpret PATTERNS as extended regular expressions
			instead of basic ones.
    -e PATTERNS		Use PATTERNS as the patterns to match. If this option is
			used multiple times, the next pattern needs to match in
			a following (but not necessarily consecutive) line.
    -E PATTERNS		Use PATTERNS as the patterns to not match. If this
			option is used multiple times, the next pattern needs to
			[not] match in a following (but not necessarily
			consecutive) line.
    --files-with-matches|-l
			Suppress normal output; instead print the name of each
			input file from which output would normally have been
			printed.
    --per-file		Reset the pattern sequence for each input file. By
			default, a pattern sequence can span multiple files.
    --unbuffered|-u	Immediately output each match.
SEE ALSO:
- (Commands offering complementary functionality, or commands using this command.)

RELATED COMMANDS:
- (Alternatives from other authors, other approaches, references not used here.)

cla-exitstatus

Example:
HELPTEXT
    printf '%q %s\n' "$(basename "$1")" '--foo bar /tmp/foobar' # TODO
}

regexpConverter()
{
    basicToExtendedRegexp "$@"
}
typeset -a awkProgressing=() awkSkip=() awkRestart=()
addPattern()
{
    local isNegated="${1?}"; shift
    local pattern="${1:?}"; shift
    local currentCount="${#awkProgressing[@]}"

    # A match with the following pattern progresses the sequence.
    awkProgressing+=("currentCount == $currentCount && ${isNegated:+! }/$(regexpConverter "$pattern")/ { recordMatch(1 + $currentCount); next }"); shift

    if [ $currentCount -gt 0 ]; then
	# If the current sequence's pattern matches again, just skip ahead. This is just
	# to prevent a match of the first pattern from resetting the sequence.
	awkSkip+=("currentCount == 1 + $currentCount && ${isNegated:+! }/$(regexpConverter "$pattern")/ { next }"); shift
    else
	# If the line didn't progress the sequence, but it matches the first pattern,
	# reset the sequence and start over.
	awkRestart+=("${isNegated:+! }/$(regexpConverter "$pattern")/ { recordMatch(1 + $currentCount); next }"); shift
    fi
}
result='return $0'
isPerFile=
isBuffered=t; [ -t 1 ] && isBuffered=
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--extended-regexp)
			shift; regexpConverter() { printf %s "$@"; };;
	-e)		shift; addPattern '' "${1:?}"; shift;;
	-E)		shift; addPattern t "${1:?}"; shift;;
	--files-with-matches|-l)
			shift; result='if (lastFilename == FILENAME) return "\n"; lastFilename = FILENAME; return FILENAME';;
	--per-file)	shift; isPerFile=t;;
	--unbuffered|-u)
			shift; isBuffered=;;
	--)		shift; break;;
	-)		break;; # For supporting special - FILE without prior --
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done
if [ ${#awkProgressing[@]} -eq 0 ]; then
    printUsage "$0" >&2
    exit 2
fi

IFS=$'\n'
${DEBUG:+env
VERBOSE_IFS="${VERBOSE_IFS-newline}"
ECHOTRACE_IFS="${ECHOTRACE_IFS-newline}"
debugcommand
--module
awk
--} awk \
    -v sequenceLength=${#awkProgressing[@]} \
    -v "isBuffered=$isBuffered" \
'
function resetCurrent() {
    currentCount = 0
    currentHasResult = 0
    currentResult = ""
}
function recordMatch( patternCount,      matchResult) {
    if (patternCount == 1) {
	resetCurrent()
	currentCount++
    } else if (++currentCount != patternCount) {
	return
    }

    matchResult = result()
    if (matchResult != "\n") {
	currentHasResult = 1
	currentResult = currentResult (currentResult == "" ? "" : "\n") matchResult
    }
    if (patternCount == sequenceLength) {
	hasMatch = 1
	if (currentHasResult) {
	    print currentResult
	    if (! isBuffered) fflush()
	}
	resetCurrent()
    }
}
'"
function result() {
    $result
}
${isPerFile:+BEGINFILE {
    resetCurrent()
\}}
${awkProgressing[*]}
${awkSkip[*]}
${awkRestart[*]}"'
END { exit(hasMatch ? 0 : 1) }
' "$@"
